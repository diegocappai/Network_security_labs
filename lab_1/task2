from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs
import json
import re

HOST = "10.8.0.32"
PORT = 8080

# 'notes_db' sarà il nostro database in memoria per memorizzare le note.
# Utilizzeremo un contatore per assegnare automaticamente un ID numerico incrementale.
notes_db = {}
next_note_id = 1

class MiniAPIHandler(BaseHTTPRequestHandler):
    
    # Metodo di supporto per inviare rapidamente risposte JSON[cite: 16]
    def send_json_response(self, status_code, data=None):
        self.send_response(status_code)
        if data is not None:
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(json.dumps(data).encode('utf-8'))
        else:
            self.end_headers()

    # Gestisce tutte le richieste GET
    def do_GET(self):
        parsed_url = urlparse(self.path)
        path = parsed_url.path
        
        # --- Regole Precedenti ---
        if path == '/':
            self.send_response(200)
            self.end_headers()
            return
            
        elif path == '/echo':
            query_params = parse_qs(parsed_url.query)
            if 'msg' in query_params:
                text_value = query_params['msg'][0]
                self.send_json_response(200, {"msg": text_value})
            else:
                self.send_response(400)
                self.end_headers()
            return
            
        # --- NUOVA REGOLA: GET /notes/<id> ---[cite: 16]
        # Usiamo un'espressione regolare per capire se l'URL ha la forma /notes/NUMERO
        match = re.match(r"^/notes/(\d+)$", path)
        if match:
            note_id = int(match.group(1))
            
            # Controlla se la nota esiste nel "database"
            if note_id in notes_db:
                # 200 with {"id": <id>, "text": "..."}[cite: 16]
                self.send_json_response(200, {"id": note_id, "text": notes_db[note_id]})
            else:
                # missing note -> 404[cite: 16]
                self.send_response(404)
                self.end_headers()
            return
            
        # Se prova a fare GET su /notes ma con id non numerico (es. /notes/pippo)[cite: 16]
        elif path.startswith('/notes/'):
             self.send_response(404) # non-numeric id -> 404[cite: 16]
             self.end_headers()
             return
             
        # Se la GET è rivolta a /notes puro (che non è supportato dalle regole GET)
        elif path == '/notes':
            self.send_response(405) # unsupported method su /notes -> 405[cite: 16]
            self.end_headers()
            return

        # any other path -> 404
        self.send_response(404)
        self.end_headers()

    # --- NUOVA REGOLA: POST /notes ---[cite: 16]
    def do_POST(self):
        global next_note_id
        parsed_url = urlparse(self.path)
        path = parsed_url.path
        
        if path == '/notes':
            # Controlla che il Content-Type sia corretto[cite: 16]
            content_type = self.headers.get('Content-Type', '')
            if content_type != 'application/json':
                self.send_response(415) # Content-Type other than application/json -> 415[cite: 16]
                self.end_headers()
                return
            
            # Legge la lunghezza del body
            content_length_str = self.headers.get('Content-Length')
            if not content_length_str:
                self.send_response(400)
                self.end_headers()
                return
                
            content_length = int(content_length_str)
            
            # Legge il body grezzo
            post_data = self.rfile.read(content_length)
            
            # Prova ad analizzare il JSON[cite: 16]
            try:
                data = json.loads(post_data.decode('utf-8'))
            except json.JSONDecodeError:
                self.send_response(400) # malformed JSON -> 400[cite: 16]
                self.end_headers()
                return
                
            # Verifica che il campo 'text' esista e sia una stringa[cite: 16]
            if 'text' not in data or not isinstance(data['text'], str):
                self.send_response(400) # missing or non-string text -> 400[cite: 16]
                self.end_headers()
                return
                
            # Salva la nota e incrementa l'ID
            note_text = data['text']
            note_id = next_note_id
            notes_db[note_id] = note_text
            next_note_id += 1
            
            # Risponde con 201 Created e il nuovo ID[cite: 16]
            self.send_json_response(201, {"id": note_id})
            
        else:
            self.send_response(404)
            self.end_headers()

    # --- NUOVA REGOLA: DELETE /notes/<id> ---[cite: 16]
    def do_DELETE(self):
        parsed_url = urlparse(self.path)
        path = parsed_url.path
        
        match = re.match(r"^/notes/(\d+)$", path)
        if match:
            note_id = int(match.group(1))
            
            # Se la nota esiste, la elimina
            if note_id in notes_db:
                del notes_db[note_id]
                self.send_response(204) # 204 ; from then on the note no longer exists[cite: 16]
                self.end_headers()
            else:
                self.send_response(404) # missing note -> 404[cite: 16]
                self.end_headers()
            return
            
        elif path.startswith('/notes/'):
             self.send_response(404) # non-numeric id -> 404[cite: 16]
             self.end_headers()
             return
             
        elif path == '/notes':
            self.send_response(405) # unsupported method su /notes -> 405[cite: 16]
            self.end_headers()
            return

        self.send_response(404)
        self.end_headers()

    # --- NUOVA REGOLA: Metodi non supportati (es. PUT) ---[cite: 16]
    # L'unico metodo per far sì che BaseHTTPRequestHandler intercetti metodi custom
    # è definirli esplicitamente, oppure sovrascrivere un metodo generale.
    # Aggiungiamo esplicitamente PUT come richiesto dall'esempio dell'immagine.
    def do_PUT(self):
         parsed_url = urlparse(self.path)
         if parsed_url.path == '/notes' or parsed_url.path.startswith('/notes/'):
             self.send_response(405) # unsupported method on /notes (e.g. PUT) -> 405[cite: 16]
             self.end_headers()
         else:
             self.send_response(404)
             self.end_headers()

def run_server():
    server_address = (HOST, PORT)
    httpd = HTTPServer(server_address, MiniAPIHandler)
    print(f"[*] REST API in ascolto sulla porta {PORT}...")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    httpd.server_close()
    print("[*] Server fermato.")

if __name__ == '__main__':
    run_server()
